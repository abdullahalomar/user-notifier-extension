{
  "manifest_version": 3,
  "name": "User Sound Notifier",
  "version": "1.0.0",
  "description": "Real-time sound notifier extension using unique device UUIDs.",
  "permissions": [
    "storage",
    "offscreen",
    "notifications"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
